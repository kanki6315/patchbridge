---
import { site } from '../site';
import appStoreBadge from '../assets/badges/app-store.svg?url';
import macAppStoreBadge from '../assets/badges/mac-app-store.svg?url';

interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['store', className]}>
  {site.appStoreUrl ? (
    <a class="badge" href={site.appStoreUrl}>
      <img src={appStoreBadge} alt="Download Patchbridge on the App Store" width={162} height={54} />
    </a>
  ) : (
    <span class="btn btn-soon">iPhone app coming soon</span>
  )}
  {site.macAppUrl ? (
    <a class="badge" href={site.macAppUrl}>
      <img src={macAppStoreBadge} alt="Download the Patchbridge Mac bridge on the Mac App Store" width={210.6} height={54} />
    </a>
  ) : (
    <span class="btn btn-soon">Mac bridge coming soon</span>
  )}
</div>

<style>
  .store {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .badge { display: inline-flex; border-radius: 0.5rem; }
  .badge img { display: block; height: 54px; width: auto; }
</style>
