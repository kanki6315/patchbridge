---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap missing">
    <p class="code" aria-hidden="true">
      <span class="slot"></span><span class="slot"></span><span class="slot"></span><span class="slot"></span>
    </p>
    <h1>Empty slot.</h1>
    <p class="lede">There's no block here. The page may have moved.</p>
    <a class="btn btn-primary" href="/">Back to Patchbridge</a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(4rem, 3rem + 8vw, 10rem);
  }
  .code { display: flex; gap: 6px; margin: 0 0 1rem; }
  .slot {
    width: 3.5rem;
    aspect-ratio: 1 / 0.92;
    border-radius: var(--r-cell);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  h1 { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem); letter-spacing: -0.035em; }
  .lede { color: var(--ink-muted); font-size: var(--text-lede); }
</style>
