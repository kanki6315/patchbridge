# Copy to .release.env (git-ignored). Values use shell syntax.
# Defaults to DEVELOPMENT_TEAM in ios/project.yml and your Xcode Apple ID.
# DEVELOPMENT_TEAM=TDBAHN96B3

# Optional App Store Connect API key. Requires a local Apple Distribution
# certificate and its private key. No keys are copied from other projects.
# ASC_KEY_ID=ABC123DEF4
# ASC_ISSUER_ID=12345678-aaaa-bbbb-cccc-1234567890ab
# ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8"

# Choose an installed regular-iPhone simulator (a device ID also works).
# TEST_DESTINATION='platform=iOS Simulator,name=iPhone 17 Pro'
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
