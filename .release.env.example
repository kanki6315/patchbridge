# Copy to .release.env (git-ignored). Values use shell syntax.
# Defaults to DEVELOPMENT_TEAM in ios/project.yml and your Xcode Apple ID.
# DEVELOPMENT_TEAM=TDBAHN96B3

# Optional App Store Connect API key. Requires a local Apple Distribution
# certificate and its private key. No keys are copied from other projects.
# ASC_KEY_ID=ABC123DEF4
# ASC_ISSUER_ID=12345678-aaaa-bbbb-cccc-1234567890ab
# ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8"

# By default, select a compatible installed iPhone by ID, preferring a
# Patchbridge-named simulator, then the newest OS. Optional explicit override:
# TEST_DESTINATION='platform=iOS Simulator,id=YOUR-SIMULATOR-UUID'
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# macOS uses the same ASC API key above. Without a key, signing and upload use
# the Apple ID signed into Xcode, just like iOS. Optional altool upload override
# using an app-specific password already stored in Keychain (set both):
# MAC_ASC_USERNAME=you@example.com
# MAC_ASC_PASSWORD_KEYCHAIN=Patchbridge-App-Store-Password
# A Mac Installer Distribution certificate/private key is also required.
# MAC_RELEASE_PYTHON=/opt/homebrew/bin/python3  # local arm64 CPython 3.14
